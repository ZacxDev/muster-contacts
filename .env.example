# Copy to .env and fill in. Placeholders only: never commit a real token.

# muster's address: https://, or http:// to localhost / 127.0.0.1 / [::1], to a
# fully-qualified Service name with its trailing dot
# (muster.<namespace>.svc.cluster.local.), or to CONTACTS_MUSTER_HTTP_HOST.
MUSTER_URL=https://muster.example.test
# CONTACTS_CLUSTER_DOMAIN=cluster.local
# CONTACTS_MUSTER_HTTP_HOST=

# The ONE mpl_… token `muster-server app install … --link-to <meetings id>`
# showed. It is the server app's: it acts for nobody until a person's own
# hand-off names them.
MUSTER_PLUGIN_TOKEN=mpl_replace_me

# muster's origin as browsers see it (the only page that may frame the tab),
# and this plugin's own origin (never the same).
MUSTER_ORIGIN=https://muster.example.test
CONTACTS_PUBLIC_URL=https://contacts-muster.example.test

# The contacts API's bearer: 32+ random bytes (openssl rand -base64 32). The
# SAME value goes in the meetings plugin's MEETINGS_CONTACTS_TOKEN. muster
# never sees it, and it may not be a muster token.
CONTACTS_API_TOKEN=replace-me-with-openssl-rand-base64-32

# Optional: the Meetings app's id on muster (`muster-server app list`), so a
# contact's meeting opens in the Meetings tab.
# CONTACTS_MEETINGS_APP_ID=

# CONTACTS_LISTEN=:8080
# CONTACTS_INTERNAL_LISTEN=:8081
STATE_DIR=./state
